# ============================================
# NEXTRANSIT — Environment Variables
# ============================================
# Copy this file to .env.local for local development.
# Set these values in the Vercel Dashboard for production.

# --- Database ---
# PostgreSQL connection string.
# Local:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nextransit"
# Vercel/Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/nextransit?sslmode=require"
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/nextransit"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret-min-32-chars"

# Local development:
NEXTAUTH_URL="http://localhost:3000"
# Production:
# NEXTAUTH_URL="https://your-app.vercel.app"

# --- Realtime Data Provider ---
# SIMULATION = use local VehiclePosition rows from database.
# GTFS_RT = connect to an official GTFS-Realtime feed when available.
REALTIME_PROVIDER=SIMULATION

# Only needed when REALTIME_PROVIDER=GTFS_RT.
GTFS_RT_VEHICLE_POSITIONS_URL=
